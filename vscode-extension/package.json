{
  "name": "forge-agent-framework",
  "displayName": "forge — Agent Framework",
  "description": "Manage forge agent projects from VS Code",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:project.yaml",
    "workspaceContains:.agentic"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forge.audit",
        "title": "forge: Run Audit"
      },
      {
        "command": "forge.auditAgent",
        "title": "forge: Audit Specific Agent"
      },
      {
        "command": "forge.init",
        "title": "forge: Initialize Project"
      },
      {
        "command": "forge.openWizard",
        "title": "forge: Open Setup Wizard"
      },
      {
        "command": "forge.searchCatalog",
        "title": "forge: Search Catalog (MCP / Profiles)"
      },
      {
        "command": "forge.showStatus",
        "title": "forge: Show Project Status"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgeExplorer",
          "title": "forge",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "forgeExplorer": [
        {
          "id": "forgeProjectView",
          "name": "Project",
          "when": "forge.active"
        },
        {
          "id": "forgeAgentsView",
          "name": "Agents",
          "when": "forge.active"
        }
      ]
    },
    "configuration": {
      "title": "forge",
      "properties": {
        "forge.forgePath": {
          "type": "string",
          "default": ".agentic",
          "description": "Path to forge installation relative to workspace root"
        },
        "forge.tool": {
          "type": "string",
          "default": "claude-code",
          "enum": [
            "claude-code",
            "opencode",
            "kiro",
            "codex",
            "all"
          ],
          "description": "Target agentic tool"
        },
        "forge.autoAuditOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run audit when an agent file is saved"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
