{
  "name": "@cristiancorreau/forge-daemon",
  "version": "0.1.0",
  "description": "FORGE v4 — infrastructure adapters (SQLite registry, fs manifest, git vcs, manifest watcher) and the forged serve HTTP API (SPEC-077)",
  "author": "Cristian Correa <cristian@socialweb.cl>",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
