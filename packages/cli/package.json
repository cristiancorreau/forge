{
  "name": "@cristiancorreau/forge",
  "version": "2.9.3",
  "description": "Agentic development framework — multi-runtime support for Claude Code, OpenCode, Codex and Kiro",
  "author": "Cristian Correa <cristian@socialweb.cl>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cristiancorreau/forge"
  },
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "opencode",
    "codex",
    "kiro",
    "agentic",
    "framework"
  ],
  "type": "module",
  "bin": {
    "forge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:assets": "node scripts/build-assets.mjs",
    "build:all": "npm run build:assets && npm run build",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build:all",
    "test": "node --test test/commands.test.mjs"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@types/boxen": "^2.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@opentui/core": "^0.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "js-yaml": "^4.2.0",
    "listr2": "^10.2.1"
  }
}
