{
  "name": "@cristiancorreau/forge-schemas",
  "version": "0.1.0",
  "description": "FORGE v4 — neutral domain contracts (JSON Schema draft-07) with generated TypeScript types and precompiled ajv validators (SPEC-075)",
  "author": "Cristian Correa <cristian@socialweb.cl>",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*.json": "./schemas/*.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc && node scripts/copy-gen-to-dist.mjs",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run generate && npm run build && npm test"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.4.0"
  }
}
