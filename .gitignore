# OS
.DS_Store

# Claude Code worktrees
.claude/worktrees/
# Claude Code runtime locks (scheduled tasks, etc.)
.claude/*.lock

# Codex workspace
.codex/

# Pencil design files
*.pen

# VS Code extension build artifacts
vscode-extension/node_modules/
vscode-extension/out/
vscode-extension/package-lock.json

# CLI build artifacts (generated at build time)
packages/cli/dist/
packages/cli/assets/
packages/cli/node_modules/
packages/cli/*.tgz
# Lockfile is Bun-only (bun.lock); npm's lockfile must not be committed
packages/cli/package-lock.json
packages/cli/README.md
packages/cli/LICENSE
packages/cli/CHANGELOG.md

# Python
__pycache__/
*.pyc
.pytest_cache/

# Test temporaries
/tmp/

# Dogfood harness — repos config con rutas absolutas locales (no commitear)
scripts/dogfood.repos.json

desktop/node_modules/
desktop/package-lock.json
